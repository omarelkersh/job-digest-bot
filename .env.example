# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Secrets — see README.md.

# --- Adzuna (Werkstudent + Europe Full-Time + Remote digests) ---
# Sign up free at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (Gulf digest + backup source for Europe Full-Time) ---
# Sign up free at https://jooble.org/api/about
# Note: free tier defaults to a 500-request cap — Gulf + Europe Full-Time
# together use ~50 calls/day, so keep an eye on usage if that's a monthly cap.
JOOBLE_API_KEY=

# --- Optional tuning ---
# DIGEST_MIN_SCORE=6
# ADZUNA_COUNTRIES=de,at,ch
# ADZUNA_FULLTIME_COUNTRIES=ie,nl,es
# JOOBLE_FULLTIME_LOCATIONS=Ireland,Netherlands,Spain
# GULF_LOCATIONS=Saudi Arabia,United Arab Emirates,Qatar
# ADZUNA_REMOTE_COUNTRIES=de,at,ch,ie,nl,es

# Set to 1 to log matches without touching the dedup store or portal feed.
DRY_RUN=
