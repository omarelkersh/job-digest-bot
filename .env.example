# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Secrets — see README.md.

# --- Adzuna (Europe digest) ---
# Sign up free at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (Gulf digest) ---
# Sign up free at https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Gmail SMTP (sends both digests) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Recipients ---
DIGEST_TO_EMAIL=
# Optional: route the Gulf digest to a different inbox. Falls back to
# DIGEST_TO_EMAIL if unset.
GULF_DIGEST_TO_EMAIL=

# --- Optional tuning ---
# DIGEST_MIN_SCORE=6
# DIGEST_MAX_JOBS_PER_EMAIL=30
# ADZUNA_COUNTRIES=de,at,nl,fr,it,es,pl,gb,ch
# GULF_LOCATIONS=Saudi Arabia,United Arab Emirates,Qatar

# Set to 1 to log what would be sent instead of actually emailing.
DRY_RUN=
